# Mahadi Hasan WhatsApp Bot — Environment Variables
# Copy these to your host (Render / Railway / VPS) environment settings.

PORT=10000
DASHBOARD_PASSWORD=your-strong-password-here
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Primary owner (digits only, country code included)
OWNER_NUMBER=8801XXXXXXXXX

# Extra owners (comma separated, optional)
OWNER_NUMBERS=8801YYYYYYYYY,8801ZZZZZZZZZ

# Optional AI override
# AI_ENDPOINT=https://hasan-indol.vercel.app/api/chat
# AI_PROVIDER=auto
